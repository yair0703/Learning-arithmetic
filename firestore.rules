rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student Tokens collection rules - allow all reads & writes
    match /studentTokens/{tokenId} {
      allow read, write: if true;
    }

    // Students collection rules - allow all reads & writes
    match /students/{studentId} {
      allow read, write: if true;
    }
    
    // Parents collection rules
    match /parents/{parentId} {
      allow read, write: if true;
    }
    
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // Global test mode fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
